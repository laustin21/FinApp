# Secrets: never commit these
.env
.env.*

# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Local app data (accounts, password hashes, friends, groups)
app.db
app.db.bak
app.db.before-reset

# Demo baseline (made by demo_setup.py; tied to your own Nessie key)
demo_baseline.db
demo_bank.json
probe_results.json
friends.db
*.db-journal

# Output from seed/test runs against your own Nessie key
deposits_log.json
purchases_log.json
merchants.json

# Frontend build output (also covered by frontend/.gitignore)
node_modules/
dist/

# The app's Solana devnet wallet (solana_vault.py). Keep it private.
solana_authority.json
